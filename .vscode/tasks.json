{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build GuruxDLMSServerExample2 (MSBuild)",
      "type": "process",
      "command": "${env:ProgramFiles}\\Microsoft Visual Studio\\18\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
      "args": [
        "${workspaceFolder}\\GuruxDLMSServerExample2\\VS\\GuruxDLMSServerExample2.sln",
        "/t:Build",
        "/p:Configuration=Debug",
        "/p:Platform=x64"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
