{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug GuruxDLMSServerExample2",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/GuruxDLMSServerExample2/VS/x64/Debug/GuruxDLMSServerExample2.exe",
      "args": [
        "-t",
        "Off",
        "-p",
        "4061",
        "-i",
        "WRAPPER"
      ],
      "cwd": "${workspaceFolder}/GuruxDLMSServerExample2/VS/x64/Debug",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "preLaunchTask": "Build GuruxDLMSServerExample2 (MSBuild)"
    },
    {
      "name": "Debug GuruxDLMSServerExample",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/GuruxDLMSServerExample/VS/x64/Debug/GuruxDLMSServerExample.exe",
      "args": [
        "-t",
        "Off",
        "-p",
        "4061"
      ],
      "cwd": "${workspaceFolder}/GuruxDLMSServerExample/VS/x64/Debug",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "preLaunchTask": "Build GuruxDLMSServerExample (MSBuild)"
    }
  ]
}
